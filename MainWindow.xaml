<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ALACConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ALAC 音乐转换器">

    <Grid x:Name="RootGrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TITLEBAR -->
        <Grid x:Name="TitleBarDrag" Grid.Row="0"
              Height="32" Padding="16,0,0,0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Border Width="18" Height="18" CornerRadius="5"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE950;" FontSize="11"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              FontFamily="Segoe Fluent Icons" />
                </Border>
                <TextBlock Text="ALAC 音乐转换器" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Border CornerRadius="8" Padding="6,1,6,1"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock x:Name="EngineBadge" Text="准备中…" FontSize="10.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- 主题切换按钮：置于标题栏拖拽区内部，靠右对齐。
                 TitleBarDrag 的右 Padding 等于系统按钮区宽度（运行时代码设置），
                 因此本按钮自动落在系统最小化/最大化/关闭按钮左侧，不会被遮挡。 -->
            <!-- 用 ButtonStyle 模板覆盖，消除 WinUI Button 默认的灰底方块 -->
            <Button x:Name="ThemeButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="36"
                    Click="OnToggleTheme"
                    ToolTipService.ToolTip="切换主题（跟随系统 / 浅色 / 深色）"
                    Style="{StaticResource BareIconButtonStyle}">
                <FontIcon x:Name="ThemeGlyph" Glyph="&#xE706;" FontSize="14"
                          FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>

        <!-- BANNER -->
        <Border x:Name="BannerBorder" Grid.Row="1" Visibility="Collapsed"
                Margin="16,10,16,0" CornerRadius="8" Padding="12,9"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1">
            <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="2" Margin="16,10,16,0" ColumnSpacing="14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：卡片与右栏卡片顶部/底部严格对齐。
                 标题放在卡片内部首行，取代原先独立的标题行（旧做法使左栏比右栏低一行）。 -->
            <Border Grid.Column="0" CornerRadius="10"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 卡片内标题行 -->
                    <Grid Grid.Row="0" Margin="14,11,14,9">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="转换队列" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="JobCountText" Text="队列为空" FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">

                        <ListView x:Name="JobsView"
                                  SelectionMode="None"
                                  Padding="4"
                                  Visibility="Collapsed"
                                  ScrollViewer.HorizontalScrollMode="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,7" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="{Binding StatusGlyph}"
                                                  FontSize="13" FontFamily="Segoe Fluent Icons"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding InputSpec}"
                                                       FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>

                                        <ProgressBar Grid.Column="2" Height="4"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Center"
                                                     Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                     Background="{ThemeResource ControlFillColorDefaultBrush}" />

                                        <Button Grid.Column="3" Width="24" Height="24"
                                                Click="OnRemoveJob"
                                                ToolTipService.ToolTip="移除"
                                                Style="{StaticResource BareIconButtonStyle}">
                                            <FontIcon Glyph="&#xE711;" FontSize="11"
                                                      FontFamily="Segoe Fluent Icons"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid x:Name="DropZone"
                              AllowDrop="True"
                              DragOver="OnDragOver"
                              Drop="OnDrop">
                            <Border x:Name="EmptyState" CornerRadius="8"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Visibility="Visible">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Spacing="12">

                                    <FontIcon Glyph="&#xE8B7;" FontSize="38"
                                              FontFamily="Segoe Fluent Icons"
                                              HorizontalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="把音频文件拖到这里"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="支持 MP3 / FLAC / WAV / AIFF / APE / M4A 等 27 种格式，也支持整个文件夹"
                                                   FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" Spacing="8"
                                                Margin="0,4,0,0">
                                        <Button x:Name="PickFilesButton" Content="选择文件"
                                                Click="OnPickFiles"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="PickFolderButton" Content="选择文件夹"
                                                Click="OnPickFolder" />
                                        <Button x:Name="ClearButton" Content="清空"
                                                Click="OnClearAll" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
                </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- 设置区与日志区都按比例分配，比例 3:2。
                         用比例而非 Auto+*：Auto 会让设置区无限增长把日志区挤没，
                         比例分配则保证两区始终有稳定空间（日志区恒为 ~40%）。 -->
                    <RowDefinition Height="3*" MinHeight="240" />
                    <RowDefinition Height="2*" MinHeight="170" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled"
                              MaxHeight="460">
                <Border CornerRadius="10" Padding="14"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">

                        <TextBlock Text="输出设置" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <StackPanel Spacing="5">
                            <TextBlock Text="保存位置" FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="选择文件夹…"
                                        Click="OnChooseOutput" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="同源目录" Click="OnSameAsSource" />
                            </Grid>
                            <TextBlock x:Name="OutputPathText" Visibility="Collapsed"
                                       FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Border CornerRadius="8" Padding="11"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE946;" FontSize="11.5"
                                              FontFamily="Segoe Fluent Icons"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Apple Music 规格"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="ALAC 无损 · 44100/48000 Hz · 16/24 bit · 立体声"
                                           FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="超采样自动降至 48 kHz，5.1 自动转立体声；已合规文件自动跳过"
                                           FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 选项分组：用带边框的内嵌卡片承载，避免松散 -->
                        <Border CornerRadius="8" Padding="10,4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Spacing="0">
                                <CheckBox x:Name="OverwriteCheck"
                                          Content="覆盖同名文件"
                                          IsChecked="False"
                                          MinHeight="30" />
                                <CheckBox x:Name="VerifyCheck"
                                          Content="转换后校验可播性"
                                          IsChecked="True"
                                          MinHeight="30" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="StartButton" Content="开始转换"
                                Click="OnStart"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,8" FontSize="13" />

                        <Button x:Name="CancelButton" Content="取消"
                                Click="OnCancel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <Button Content="打开输出文件夹"
                                Click="OnOpenOutput"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Border>

                </ScrollViewer>

                <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="10"
                        MinHeight="150"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Padding="12,9,8,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="运行日志" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Button Grid.Column="1" Content="复制" FontSize="10.5"
                                    Click="OnCopyLog" Margin="0,0,2,0"
                                    Style="{StaticResource QuietTextButtonStyle}" />
                            <Button Grid.Column="2" Content="清空" FontSize="10.5"
                                    Click="OnClearLog"
                                    Style="{StaticResource QuietTextButtonStyle}" />
                        </Grid>
                        <ScrollViewer x:Name="LogScroll" Grid.Row="1" Padding="12,0,12,10">
                            <TextBlock x:Name="LogText" TextWrapping="Wrap"
                                       FontSize="11" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <!-- 底部状态条：单行紧凑排布，把纵向空间尽量留给主体（日志区） -->
        <Border Grid.Row="3" Margin="16,10,16,12" CornerRadius="8" Padding="12,7"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BatchStatusText" Text="就绪" FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="BatchProgress" Grid.Column="1" Height="4"
                             Minimum="0" Maximum="100" Value="0"
                             VerticalAlignment="Center"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock Grid.Column="2" Text="输出 .m4a 无损，可直接导入 iTunes / 音乐 App"
                           FontSize="10.5" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
